PORT=4100

# Optional: Google Sheets API key (Sheets API v4 enabled) for the "Drink FIFO"
# inventory sheet. If unset, the server falls back to the sheet's public CSV
# export (requires the sheet to be shared "Anyone with the link – Viewer"),
# and if that also fails, to the bundled snapshot in src/inventory/snapshot.ts.
GOOGLE_SHEETS_API_KEY=

# Override the source spreadsheet / tab if the inventory sheet ever moves.
GOOGLE_SHEET_ID=1MctJ_HYxGiPTs-G6Mdlbfdx6XqU4i3LoCWnTpgThDg0
GOOGLE_SHEET_TAB=Inventory
